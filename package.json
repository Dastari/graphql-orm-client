{
  "name": "graphql-orm-client",
  "version": "0.1.0-alpha.9",
  "description": "A GraphQL client for graphql-orm APIs: colocated fragments, compiled route queries, a normalised store and live Changed subscriptions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dastari/graphql-orm-client.git"
  },
  "bugs": "https://github.com/Dastari/graphql-orm-client/issues",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "AGENTS.md",
    "llms.txt",
    "skills",
    "bin"
  ],
  "bin": {
    "graphql-orm-client": "./bin/graphql-orm-client.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && node bin/graphql-orm-client.mjs skills list > /dev/null",
    "prepack": "pnpm build",
    "conformance": "node conformance/run.mjs",
    "budgets": "pnpm build && node --expose-gc budgets/run.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "import": "./dist/test/index.js"
    }
  },
  "peerDependencies": {
    "graphql": "^16.9.0",
    "react": ">=19 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.4.1",
    "jsdom": "^30.1.3",
    "playwright": "^1.65.0",
    "playwright-core": "^1.65.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.1"
  }
}
