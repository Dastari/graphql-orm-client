  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dastari/graphql-orm-client.git"
  },
  "bugs": "https://github.com/Dastari/graphql-orm-client/issues",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "AGENTS.md",
    "llms.txt",
    "skills",
    "bin"
  ],
  "bin": {
    "graphql-orm-client": "./bin/graphql-orm-client.mjs"
  },
  "scripts": {
    "check": "node bin/graphql-orm-client.mjs skills list > /dev/null"
